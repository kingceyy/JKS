# URL de base de ton bot Python (aiohttp server)
# Ex: https://mon-bot.railway.app  ou  http://localhost:8080 en dev
VITE_BOT_API_URL=https://YOUR_BOT_DOMAIN.com

# Adresse TON qui reçoit les paiements (format user-friendly TON)
# Ex: UQD... (commence par UQ)
VITE_TON_WALLET=UQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL complète du manifest TON Connect (hébergé dans /public)
VITE_TONCONNECT_MANIFEST_URL=https://YOUR_MINIAPP_DOMAIN.com/tonconnect-manifest.json
